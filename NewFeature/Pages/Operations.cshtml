@page
@model OperationsModel
@using NewFeature.Pages.Shared
@using NewFeature.Services.ExcelImport
@{
    ViewData["Title"] = "إدارة العمليات - رفع البيانات";
}

@* Operations in the ERP is data entry only: the approved dispatch-log template. Every KPI computed
   from it is shown on the executive dashboard. *@
@{
    var landing = new DepartmentUploadLanding
    {
        Title = "إدارة العمليات",
        Subtitle = "رفع سجل أوامر التشغيل الشهري. المؤشرات المحسوبة منه تظهر في لوحة المؤشرات التنفيذية.",
        Icon = "bi-bus-front",
        TemplateUrl = "/api/operations/template",
        UploadUrl = "/api/operations/bulk-upload",
        Sheets = new[] { DepartmentTemplates.Operations }
    };
}
<partial name="_DepartmentUploadLanding" model="landing" />

<!-- Records: the uploaded dispatch log, with add / edit / delete -->
<div class="mb-5">
    <h5 class="fw-bold mb-3"><i class="bi bi-table me-2"></i>سجل أوامر التشغيل</h5>
    <div id="crud-dispatch"></div>
</div>

@section Scripts {
    <script>
        (function () {
            const f = RawahelCrud.format;
            RawahelCrud.mount({
                el: '#crud-dispatch',
                itemName: 'أمر تشغيل',
                listUrl: '/api/operations/records',
                createUrl: '/api/operations/records',
                itemUrl: id => '/api/operations/records/' + id,
                dateFilter: true,
                searchPlaceholder: 'بحث بأمر الإيجار أو العميل أو رقم الحافلة أو السائق أو الخط...',
                columns: [
                    { key: 'deliveryDate', label: 'تاريخ التنفيذ', format: v => f.date(v) },
                    { key: 'direction', label: 'الخط', format: (v, r) => f.esc(r.directionName || v) },
                    { key: 'rentOrder', label: 'أمر الإيجار', format: v => '<strong>' + f.esc(v) + '</strong>' },
                    { key: 'customerName', label: 'العميل' },
                    { key: 'busNumber', label: 'رقم الحافلة' },
                    { key: 'driverName', label: 'السائق' },
                    { key: 'plannedKm', label: 'كم مخطط', format: v => f.number(v, 0) },
                    { key: 'actualKm', label: 'كم فعلي', format: v => f.number(v, 0) },
                    { key: 'dieselLiters', label: 'ديزل', format: v => f.number(v, 0) },
                    { key: 'completion', label: 'الحالة' }
                ],
                fields: [
                    { key: 'direction', label: 'Direction (كود الخط)', required: true, col: 4 },
                    { key: 'directionName', label: 'Direction Name (اسم الخط)', col: 8 },
                    { key: 'rentOrder', label: 'Rent Order (أمر الإيجار)', required: true, col: 4 },
                    { key: 'customerAccount', label: 'Customer account (حساب العميل)', col: 4 },
                    { key: 'customerName', label: 'Name (اسم العميل)', required: true, col: 4 },
                    { key: 'busType', label: 'Bus Type (نوع الحافلة)', col: 4 },
                    { key: 'busNumber', label: 'Bus number (رقم الحافلة)', required: true, col: 4 },
                    { key: 'deliveryDate', label: 'DELV. Date (تاريخ التنفيذ)', type: 'date', required: true, col: 4 },
                    { key: 'plannedStart', label: 'PlannedStart (بداية مخططة)', type: 'datetime', col: 6 },
                    { key: 'plannedEnd', label: 'PlannedEnd (نهاية مخططة)', type: 'datetime', col: 6 },
                    { key: 'driverNumber', label: 'Driver NO. (رقم السائق)', col: 4 },
                    { key: 'driverName', label: 'Driver Name (اسم السائق)', required: true, col: 8 },
                    { key: 'additionalDriverNumber', label: 'ADD. Driver (رقم السائق المساعد)', col: 4 },
                    { key: 'additionalDriverName', label: 'ADD. Driver Name (اسم السائق المساعد)', col: 8 },
                    { key: 'location', label: 'Location (الموقع)', col: 4 },
                    { key: 'fromLocation', label: 'From Location (من)', col: 4 },
                    { key: 'toLocation', label: 'To Location (إلى)', col: 4 },
                    { key: 'plannedKm', label: 'PlannedKM (كم مخطط)', type: 'number', col: 3 },
                    { key: 'actualKm', label: 'ActualKM (كم فعلي)', type: 'number', col: 3 },
                    { key: 'dieselLiters', label: 'Desiel (الديزل)', type: 'number', col: 3 },
                    { key: 'completion', label: 'Completeion (حالة التنفيذ)', type: 'select', required: true, col: 3,
                      options: [{ value: 'Completed', label: 'Completed - منفذ' }, { value: 'Cancelled', label: 'Cancelled - ملغي' }] }
                ]
            });
        })();
    </script>
}
