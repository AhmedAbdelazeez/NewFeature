@model string
@* Moves between the three Sales pages without going back to the landing page. The model is the
   current page's key: "customers", "fleet" or "operations". *@
@{
    var tabs = new[]
    {
        (Key: "customers", Url: "/SalesCustomers", Icon: "bi-people", Label: "قائمة العملاء"),
        (Key: "fleet", Url: "/SalesFleet", Icon: "bi-bus-front", Label: "الطاقة الاستيعابية"),
        (Key: "operations", Url: "/SalesOperations", Icon: "bi-calendar-check", Label: "التشغيل اليومي")
    };
}
<div class="d-flex align-items-center gap-2 flex-wrap pt-4">
    <a href="/Sales" class="btn btn-sm btn-link text-muted text-decoration-none px-0 me-2">
        <i class="bi bi-arrow-right me-1"></i>إدارة المبيعات
    </a>
    @foreach (var tab in tabs)
    {
        <a href="@tab.Url" class="btn btn-sm @(tab.Key == Model ? "btn-neon" : "btn-neon-outline")">
            <i class="bi @tab.Icon me-1"></i>@tab.Label
        </a>
    }
</div>
