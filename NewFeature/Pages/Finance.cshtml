@page
@model FinanceModel
@{
    ViewData["Title"] = "الإدارة المالية";
}

@* The Finance department's entry point. The department uploads two separate files, on two separate
   clocks, so each one has its own page: the chart of accounts (reference data, changes when
   accounts are opened) and the monthly trial balance (every month). Every KPI computed from them is
   shown on the executive dashboard, never here. *@

<div class="py-4">
    <div class="mb-4">
        <h1 class="display-6 fw-extrabold glow-text mb-1" style="font-family: var(--font-outfit);">
            <i class="bi bi-cash-coin me-2"></i>الإدارة المالية
        </h1>
        <p class="text-muted fs-6 mb-0">
            النموذجان المعتمدان منفصلان: شجرة الحسابات تُرفع أولاً ثم تُرفع الأرصدة الشهرية، فكل رصيد يُصنَّف من خلال الشجرة.
        </p>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <a href="/FinanceAccounts" class="text-decoration-none">
                <div class="glass-card p-4 h-100 d-flex flex-column">
                    <div class="text-muted small fw-bold mb-2">الخطوة 1</div>
                    <h5 class="fw-bold mb-2"><i class="bi bi-diagram-3 me-2"></i>شجرة الحسابات (COA)</h5>
                    <p class="text-muted small flex-grow-1">
                        دليل الحسابات وتصنيفاته (Mapping، RSM، التصنيف الإداري، تصنيف الإيرادات).
                        يُرفع أول مرة وعند فتح حسابات جديدة فقط، وهو ما يحوّل كل رصيد إلى إيراد أو تكلفة أو بند في المركز المالي.
                    </p>
                    <span class="btn btn-neon-outline btn-sm align-self-start">فتح الصفحة <i class="bi bi-arrow-left ms-1"></i></span>
                </div>
            </a>
        </div>

        <div class="col-md-6">
            <a href="/FinanceBalances" class="text-decoration-none">
                <div class="glass-card p-4 h-100 d-flex flex-column">
                    <div class="text-muted small fw-bold mb-2">الخطوة 2</div>
                    <h5 class="fw-bold mb-2"><i class="bi bi-table me-2"></i>الأرصدة والحركات المالية</h5>
                    <p class="text-muted small flex-grow-1">
                        ميزان المراجعة الشهري: الرصيد الافتتاحي والمدين والدائن لكل حساب، لكل فرع.
                        يُرفع كل شهر، وإعادة رفع نفس الشهر تُحدّث الأرقام ولا تكررها.
                    </p>
                    <span class="btn btn-neon btn-sm align-self-start">فتح الصفحة <i class="bi bi-arrow-left ms-1"></i></span>
                </div>
            </a>
        </div>
    </div>
</div>
