@page
@model FinanceModel
@using NewFeature.Pages.Shared
@using NewFeature.Services.ExcelImport
@{
    ViewData["Title"] = "الإدارة المالية - رفع البيانات";
}

@* Finance in the ERP is data entry only: one workbook carrying the chart of accounts (COA) and the
   account balances (الحركات المالية). Every KPI computed from it is shown on the executive
   dashboard. *@
@{
    var landing = new DepartmentUploadLanding
    {
        Title = "الإدارة المالية",
        Subtitle = "رفع النموذج المالي (شجرة الحسابات + الأرصدة) في ملف واحد. المؤشرات المحسوبة منه تظهر في لوحة المؤشرات التنفيذية.",
        Icon = "bi-cash-coin",
        TemplateUrl = "/api/finance/template",
        UploadUrl = "/api/finance/bulk-upload",
        Sheets = new[] { DepartmentTemplates.FinanceChartOfAccounts, DepartmentTemplates.FinanceBalances }
    };
}
<partial name="_DepartmentUploadLanding" model="landing" />

<!-- Records: the template's two sheets, each with add / edit / delete -->
<ul class="nav nav-tabs nav-tabs-glass mb-3" role="tablist">
    <li class="nav-item">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-balances" type="button" role="tab">الأرصدة (الحركات المالية)</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-coa" type="button" role="tab">شجرة الحسابات (COA)</button>
    </li>
</ul>
<div class="tab-content mb-5">
    <div class="tab-pane fade show active" id="tab-balances" role="tabpanel"><div id="crud-balances"></div></div>
    <div class="tab-pane fade" id="tab-coa" role="tabpanel"><div id="crud-coa"></div></div>
</div>

@section Scripts {
    <script>
        (function () {
            const f = RawahelCrud.format;
            RawahelCrud.mount({
                el: '#crud-balances',
                itemName: 'رصيد',
                listUrl: '/api/finance/balances',
                createUrl: '/api/finance/balances',
                itemUrl: id => '/api/finance/balances/' + id,
                searchPlaceholder: 'بحث برقم الحساب أو اسم الحساب...',
                columns: [
                    { key: 'date', label: 'التاريخ', format: v => f.date(v) },
                    { key: 'accountNumber', label: 'رقم الحساب', format: v => '<strong>' + f.esc(v) + '</strong>' },
                    { key: 'accountName', label: 'اسم الحساب' },
                    { key: 'classification', label: 'التصنيف', format: v => '<span class="small text-muted">' + f.esc(v || '--') + '</span>' },
                    { key: 'balance', label: 'الرصيد', format: v => f.number(v, 2) }
                ],
                fields: [
                    { key: 'date', label: 'Date (التاريخ)', type: 'date', required: true, col: 4 },
                    { key: 'accountNumber', label: 'Account No (رقم الحساب)', required: true, col: 4 },
                    { key: 'balance', label: 'Balance (الرصيد)', type: 'number', required: true, col: 4 },
                    { key: 'accountName', label: 'Account Name (اسم الحساب) - يُملأ من الشجرة إن تُرك فارغاً', col: 12 }
                ]
            });

            RawahelCrud.mount({
                el: '#crud-coa',
                itemName: 'حساب',
                listUrl: '/api/finance/chart-of-accounts/paged',
                createUrl: '/api/finance/chart-of-accounts',
                itemUrl: id => '/api/finance/chart-of-accounts/' + id,
                searchPlaceholder: 'بحث برقم الحساب أو الاسم أو التصنيف...',
                columns: [
                    { key: 'accountNumber', label: 'رقم الحساب', format: v => '<strong>' + f.esc(v) + '</strong>' },
                    { key: 'accountName', label: 'اسم الحساب' },
                    { key: 'rsmClassification', label: 'تصنيف RSM' },
                    { key: 'managementClassification', label: 'التصنيف الإداري' }
                ],
                fields: [
                    { key: 'accountNumber', label: 'Account # (رقم الحساب)', required: true, col: 4 },
                    { key: 'accountName', label: 'Account Name (اسم الحساب)', required: true, col: 8 },
                    { key: 'rsmClassification', label: 'RSM Classification (مثال: 7000   Revenues)', required: true, col: 6 },
                    { key: 'managementClassification', label: 'Management Classification', col: 6 },
                    { key: 'mapping', label: 'Mapping', col: 6 },
                    { key: 'bsClassification', label: 'BS Classification', col: 6 },
                    { key: 'isClassification', label: 'IS Classification', col: 6 },
                    { key: 'revenueMainClassification', label: 'Revenues Main Classification', col: 6 },
                    { key: 'revenueSubClassification', label: 'Revenues Sub Classification', col: 6 }
                ]
            });
        })();
    </script>
}
