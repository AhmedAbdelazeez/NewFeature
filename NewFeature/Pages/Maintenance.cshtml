@page
@model NewFeature.Pages.MaintenanceModel
@using NewFeature.Pages.Shared
@using NewFeature.Services.ExcelImport
@{
    ViewData["Title"] = "إدارة الصيانة - رفع البيانات";
}

@* Maintenance in the ERP is data entry only: the approved "Internal work orders" template. Every
   KPI computed from it is shown on the executive dashboard. *@
@{
    var landing = new DepartmentUploadLanding
    {
        Title = "إدارة الصيانة",
        Subtitle = "رفع سجل أوامر العمل الداخلية للورشة. المؤشرات المحسوبة منه تظهر في لوحة المؤشرات التنفيذية.",
        Icon = "bi-tools",
        TemplateUrl = "/api/maintenance/template",
        UploadUrl = "/api/maintenance/bulk-upload",
        AskForBranch = true,
        Sheets = new[] { DepartmentTemplates.Maintenance }
    };
}
<partial name="_DepartmentUploadLanding" model="landing" />

<!-- Records: the uploaded work orders, with add / edit / delete -->
<div class="mb-5">
    <h5 class="fw-bold mb-3"><i class="bi bi-table me-2"></i>سجل أوامر العمل الداخلية</h5>
    <div id="crud-workorders"></div>
</div>

@section Scripts {
    <script>
        (function () {
            const f = RawahelCrud.format;
            // WorkOrderStatus: 0 Pending (older rows only), 1 InAnalysis, 2 WaitingParts, 3 Completed.
            const statusLabels = { 0: 'معلق', 1: 'جاري العمل', 2: 'متوقف علي قطع غيار', 3: 'تم الانتهاء' };
            RawahelCrud.mount({
                el: '#crud-workorders',
                itemName: 'أمر عمل',
                listUrl: '/api/maintenance/workorders/paged',
                createUrl: '/api/maintenance',
                itemUrl: id => '/api/maintenance/' + id,
                dateFilter: true,
                searchPlaceholder: 'بحث برقم أمر العمل أو رقم الحافلة أو العطل أو الفني أو المشرف...',
                columns: [
                    { key: 'workOrderNumber', label: 'رقم أمر العمل', format: v => '<strong>' + f.esc(v || '--') + '</strong>' },
                    { key: 'busNumber', label: 'رقم الحافلة', format: (v, r) => f.esc(v || r.vehiclePlate) },
                    { key: 'timeIn', label: 'الدخول', format: v => f.dateTime(v) },
                    { key: 'timeOut', label: 'الخروج', format: v => f.dateTime(v) },
                    { key: 'odometer', label: 'العداد', format: v => f.number(v, 0) },
                    { key: 'breakdownDescription', label: 'وصف العطل' },
                    { key: 'technicianName', label: 'الفنيون', format: (v, r) => f.esc([r.technicianName, r.technicianName2, r.technicianName3, r.technicianName4].filter(Boolean).join('، ') || '--') },
                    { key: 'status', label: 'الحالة', format: v => f.esc(statusLabels[v] || '--') },
                    { key: 'supervisorName', label: 'المشرف' }
                ],
                fields: [
                    { key: 'workOrderNumber', label: 'رقم امر العمل', required: true, col: 4 },
                    { key: 'busNumber', label: 'رقم الحافلة', required: true, col: 4 },
                    { key: 'odometer', label: 'عداد كم الحالي', type: 'number', col: 4 },
                    { key: 'breakdownDescription', label: 'وصف العطل', type: 'textarea', required: true, col: 12 },
                    { key: 'timeIn', label: 'تاريخ وساعة الدخول', type: 'datetime', required: true, col: 6 },
                    { key: 'timeOut', label: 'تاريخ وساعة الخروج', type: 'datetime', col: 6 },
                    { key: 'technicianName', label: 'اسم الفنى 1', required: true, col: 6 },
                    { key: 'technicianName2', label: 'اسم الفنى 2', col: 6 },
                    { key: 'technicianName3', label: 'اسم الفنى 3', col: 6 },
                    { key: 'technicianName4', label: 'اسم الفنى 4', col: 6 },
                    { key: 'status', label: 'حالة', type: 'select-int', required: true, col: 4, default: 1,
                      options: [{ value: 3, label: 'تم الانتهاء' }, { value: 1, label: 'جاري العمل' }, { value: 2, label: 'متوقف علي قطع غيار' }] },
                    { key: 'supervisorName', label: 'اسم المشرف', col: 4 },
                    { key: 'branchLocation', label: 'الورشة / الفرع', col: 4, default: 'الورشة المركزية' },
                    { key: 'remarks', label: 'ملاحظات', type: 'textarea', col: 12 }
                ]
            });
        })();
    </script>
}
