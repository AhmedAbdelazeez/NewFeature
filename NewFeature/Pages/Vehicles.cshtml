@page
@model NewFeature.Pages.VehiclesModel
@{
    ViewData["Title"] = "Fleet Management - Vehicles";
}

<div class="py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="glow-text"><i class="bi bi-truck me-2"></i> <span data-i18n="vehicles-title">Fleet Vehicles</span></h1>
            <p class="text-muted mb-0" data-i18n="vehicles-subtitle">Manage vehicle assets, capacity, and current operational states</p>
        </div>
        <div>
            <a class="btn btn-outline-secondary me-2" href="/templates/Vehicle_Management_Template.xlsx" download>
                <i class="bi bi-download"></i> Download Template
            </a>
            <input type="file" id="bulkUploadFile" class="d-none" accept=".xlsx" onchange="handleBulkUpload(event, '/api/vehicles/bulk-upload')">
            <button class="btn btn-neon-outline me-2" onclick="document.getElementById('bulkUploadFile').click()">
                <i class="bi bi-file-earmark-excel"></i> <span data-i18n="vehicles-btn-bulk">Bulk Upload</span>
            </button>
            <button class="btn btn-neon" onclick="openAddModal()">
                <i class="bi bi-plus-circle me-1"></i> <span data-i18n="vehicles-btn-add">Add Vehicle</span>
            </button>
        </div>
    </div>

    <!-- Toolbar -->
    <div class="glass-card mb-4 p-3">
        <div class="row align-items-center g-3">
            <div class="col-md-8">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-glass text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" id="vehicleSearch" class="form-control form-control-glass" placeholder="Search by plate, bus number, chassis, make, model or status..." onkeyup="handleSearchKeyup(event)">
                </div>
            </div>
            <div class="col-md-2">
                <select id="pageSizeSelect" class="form-control form-control-glass" onchange="changePageSize()">
                    <option value="10">10 / page</option>
                    <option value="20" selected>20 / page</option>
                    <option value="50">50 / page</option>
                    <option value="100">100 / page</option>
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-neon-outline btn-sm w-100" onclick="applySearch()"><span data-i18n="vehicles-btn-search">Search</span></button>
            </div>
        </div>
    </div>

    <!-- Vehicles List -->
    <div class="glass-card">
        <div class="table-responsive">
            <table class="table table-glass text-white align-middle" id="vehiclesTable">
                <thead>
                    <tr>
                        <th data-i18n="vehicles-th-plate">License Plate</th>
                        <th data-i18n="vehicles-th-busno">Bus No.</th>
                        <th data-i18n="vehicles-th-make">Make &amp; Model</th>
                        <th data-i18n="vehicles-th-year">Year</th>
                        <th data-i18n="vehicles-th-capacity">Capacity</th>
                        <th data-i18n="vehicles-th-status">Status</th>
                        <th data-i18n="vehicles-th-assignment">Assignment</th>
                        <th data-i18n="vehicles-th-actions" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="vehiclesList">
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted"><i class="bi bi-arrow-repeat spin me-2"></i> Loading fleet vehicles...</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="d-flex justify-content-between align-items-center p-3 flex-wrap gap-2">
            <span class="text-muted small" id="pageInfo">--</span>
            <div>
                <button class="btn btn-neon-outline btn-sm me-2" onclick="firstPage()" data-i18n="vehicles-btn-first">&laquo; First</button>
                <button class="btn btn-neon-outline btn-sm me-2" onclick="prevPage()" data-i18n="vehicles-btn-prev">Previous</button>
                <button class="btn btn-neon-outline btn-sm me-2" onclick="nextPage()" data-i18n="vehicles-btn-next">Next</button>
                <button class="btn btn-neon-outline btn-sm" onclick="lastPage()" data-i18n="vehicles-btn-last">Last &raquo;</button>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Vehicle Modal -->
<div class="modal fade" id="vehicleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-glass">
            <div class="modal-header modal-header-glass">
                <h5 class="modal-title glow-text" id="modalTitle" data-i18n="vehicles-btn-add">Add Vehicle</h5>
                <button type="button" class="close-btn-glass" data-bs-dismiss="modal" aria-label="Close">&times;</button>
            </div>
            <form id="vehicleForm" onsubmit="saveVehicle(event)">
                <div class="modal-body p-4">
                    <input type="hidden" id="vehicleId">
                    <!-- Fields the register-seeded rows carry but this form doesn't expose for
                         editing yet; preserved as-is on Save so editing e.g. Status through this
                         form doesn't blank them out. -->
                    <input type="hidden" id="busNumber">
                    <input type="hidden" id="chassisNumber">
                    <input type="hidden" id="busTypeCode">
                    <input type="hidden" id="hasAirConditioning" value="false">
                    <input type="hidden" id="maxKilometers">
                    <input type="hidden" id="isInStorage" value="false">
                    <input type="hidden" id="responsibilityCode">
                    <input type="hidden" id="responsibleEmployeeName">

                    <div class="mb-3">
                        <label for="licensePlate" class="form-label" data-i18n="vehicles-lbl-plate">License Plate</label>
                        <input type="text" id="licensePlate" class="form-control form-control-glass" required>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="make" class="form-label" data-i18n="vehicles-lbl-make">Make</label>
                            <input type="text" id="make" class="form-control form-control-glass" required>
                        </div>
                        <div class="col-md-6">
                            <label for="model" class="form-label" data-i18n="vehicles-lbl-model">Model</label>
                            <input type="text" id="model" class="form-control form-control-glass" required>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="year" class="form-label" data-i18n="vehicles-lbl-year">Year</label>
                            <input type="number" id="year" class="form-control form-control-glass" min="1900" max="2100" required>
                        </div>
                        <div class="col-md-6">
                            <label for="capacity" class="form-label" data-i18n="vehicles-lbl-capacity">Capacity</label>
                            <input type="number" step="0.01" id="capacity" class="form-control form-control-glass" placeholder="Unknown">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="status" class="form-label" data-i18n="vehicles-lbl-status">Vehicle Status</label>
                        <select id="status" class="form-control form-control-glass" required>
                            <option value="0">Available</option>
                            <option value="1">Active</option>
                            <option value="2">In Maintenance</option>
                            <option value="3">Out Of Service</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer modal-footer-glass">
                    <button type="button" class="btn btn-neon-outline" data-bs-dismiss="modal" data-i18n="btn-cancel">Cancel</button>
                    <button type="submit" class="btn btn-neon" data-i18n="btn-save">Save Vehicle</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const currentLang = localStorage.getItem('lang') || 'en';
        let currentPage = 1;
        let pageSize = 20;
        let searchTerm = '';
        let totalPages = 1;

        const statusMeta = {
            0: { text: "Available", class: "badge-glow-success" },
            1: { text: "Active", class: "badge-glow-info" },
            2: { text: "In Maintenance", class: "badge-glow-warning" },
            3: { text: "Out of Service", class: "badge-glow-danger" }
        };

        const statusMetaAr = {
            0: { text: "متاحة", class: "badge-glow-success" },
            1: { text: "نشطة", class: "badge-glow-info" },
            2: { text: "قيد الصيانة", class: "badge-glow-warning" },
            3: { text: "خارج الخدمة", class: "badge-glow-danger" }
        };

        document.addEventListener("DOMContentLoaded", function () {
            loadVehicles();
        });

        async function loadVehicles() {
            const tbody = document.getElementById("vehiclesList");
            tbody.innerHTML = `<tr><td colspan="8" class="text-center py-4 text-muted"><i class="bi bi-arrow-repeat spin me-2"></i> Loading fleet vehicles...</td></tr>`;

            let url = `/api/vehicles/paged?page=${currentPage}&pageSize=${pageSize}`;
            if (searchTerm) url += `&search=${encodeURIComponent(searchTerm)}`;

            try {
                const res = await fetch(url);
                if (!res.ok) return;
                const data = await res.json();
                totalPages = data.totalPages || 1;
                renderVehicles(data.items || []);
                document.getElementById('pageInfo').innerText =
                    (currentLang === 'en'
                        ? `Page ${data.page} of ${totalPages} (${data.totalCount} vehicles)`
                        : `صفحة ${data.page} من ${totalPages} (${data.totalCount} مركبة)`);
            } catch (err) {
                console.error(err);
            }
        }

        function renderVehicles(vehicles) {
            const tbody = document.getElementById("vehiclesList");
            tbody.innerHTML = "";

            if (vehicles.length === 0) {
                tbody.innerHTML = `<tr><td colspan="8" class="text-center text-muted">No vehicles found.</td></tr>`;
                return;
            }

            vehicles.forEach(v => {
                const status = currentLang === 'en' ? statusMeta[v.status] : statusMetaAr[v.status];
                const badge = `<span class="${status.class}">${status.text}</span>`;
                const capacityText = (v.capacity === null || v.capacity === undefined) ? '—' : v.capacity;

                let assignment;
                if (v.isInStorage) {
                    assignment = currentLang === 'en' ? '<span class="text-muted">In storage</span>' : '<span class="text-muted">في المستودع</span>';
                } else if (v.responsibleEmployeeName) {
                    assignment = `${v.responsibleEmployeeName}${v.responsibilityCode ? ' (' + v.responsibilityCode + ')' : ''}`;
                } else {
                    assignment = '—';
                }

                const tr = document.createElement("tr");
                tr.innerHTML = `
                    <td><strong>${v.licensePlate}</strong></td>
                    <td>${v.busNumber || '—'}</td>
                    <td>${v.make} ${v.model}</td>
                    <td>${v.year}</td>
                    <td>${capacityText}</td>
                    <td>${badge}</td>
                    <td>${assignment}</td>
                    <td class="text-end">
                        <button class="btn btn-neon-outline btn-sm me-2" onclick="viewVehicleDetails(${v.id})"><i class="bi bi-eye"></i></button>
                        <button class="btn btn-neon-outline btn-sm me-2" onclick="editVehicle(${v.id})"><i class="bi bi-pencil-square"></i></button>
                        <button class="btn btn-neon-danger btn-sm" onclick="deleteVehicle(${v.id})"><i class="bi bi-trash"></i></button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function handleSearchKeyup(event) {
            if (event.key === 'Enter') applySearch();
        }

        function applySearch() {
            searchTerm = document.getElementById("vehicleSearch").value.trim();
            currentPage = 1;
            loadVehicles();
        }

        function changePageSize() {
            pageSize = parseInt(document.getElementById("pageSizeSelect").value, 10);
            currentPage = 1;
            loadVehicles();
        }

        function firstPage() {
            if (currentPage !== 1) { currentPage = 1; loadVehicles(); }
        }

        function prevPage() {
            if (currentPage > 1) { currentPage--; loadVehicles(); }
        }

        function nextPage() {
            if (currentPage < totalPages) { currentPage++; loadVehicles(); }
        }

        function lastPage() {
            if (currentPage !== totalPages) { currentPage = totalPages; loadVehicles(); }
        }

        function resetModalReadOnly(formId) {
            const form = document.getElementById(formId);
            form.querySelectorAll("input, select, textarea").forEach(el => el.disabled = false);
            const saveBtn = form.querySelector("button[type='submit']");
            if (saveBtn) saveBtn.style.display = "";
        }

        function setExtendedFields(v) {
            document.getElementById("busNumber").value = v?.busNumber || "";
            document.getElementById("chassisNumber").value = v?.chassisNumber || "";
            document.getElementById("busTypeCode").value = v?.busTypeCode || "";
            document.getElementById("hasAirConditioning").value = v?.hasAirConditioning ? "true" : "false";
            document.getElementById("maxKilometers").value = (v?.maxKilometers ?? "");
            document.getElementById("isInStorage").value = v?.isInStorage ? "true" : "false";
            document.getElementById("responsibilityCode").value = v?.responsibilityCode || "";
            document.getElementById("responsibleEmployeeName").value = v?.responsibleEmployeeName || "";
        }

        function openAddModal() {
            resetModalReadOnly("vehicleForm");
            document.getElementById("vehicleForm").reset();
            document.getElementById("vehicleId").value = "";
            setExtendedFields(null);
            document.getElementById("modalTitle").innerText = currentLang === 'en' ? "Add Vehicle" : "إضافة مركبة";

            const modal = new bootstrap.Modal(document.getElementById('vehicleModal'));
            modal.show();
        }

        async function editVehicle(id) {
            resetModalReadOnly("vehicleForm");
            try {
                const res = await fetch(`/api/vehicles/${id}`);
                if (res.ok) {
                    const v = await res.json();
                    document.getElementById("vehicleId").value = v.id;
                    document.getElementById("licensePlate").value = v.licensePlate;
                    document.getElementById("make").value = v.make;
                    document.getElementById("model").value = v.model;
                    document.getElementById("year").value = v.year;
                    document.getElementById("capacity").value = (v.capacity === null || v.capacity === undefined) ? "" : v.capacity;
                    document.getElementById("status").value = v.status;
                    setExtendedFields(v);

                    document.getElementById("modalTitle").innerText = currentLang === 'en' ? "Edit Vehicle Info" : "تعديل معلومات المركبة";

                    const modal = new bootstrap.Modal(document.getElementById('vehicleModal'));
                    modal.show();
                }
            } catch (err) {
                console.error(err);
            }
        }

        async function viewVehicleDetails(id) {
            await editVehicle(id);
            document.getElementById("modalTitle").innerText = currentLang === 'en' ? "Vehicle Details" : "تفاصيل المركبة";
            const form = document.getElementById("vehicleForm");
            form.querySelectorAll("input, select, textarea").forEach(el => el.disabled = true);
            const saveBtn = form.querySelector("button[type='submit']");
            if (saveBtn) saveBtn.style.display = "none";
        }

        async function saveVehicle(e) {
            e.preventDefault();

            const id = document.getElementById("vehicleId").value;
            const capacityRaw = document.getElementById("capacity").value;
            const maxKmRaw = document.getElementById("maxKilometers").value;

            const dto = {
                id: id ? parseInt(id) : 0,
                busNumber: document.getElementById("busNumber").value || null,
                licensePlate: document.getElementById("licensePlate").value,
                make: document.getElementById("make").value,
                model: document.getElementById("model").value,
                year: parseInt(document.getElementById("year").value),
                capacity: capacityRaw === "" ? null : parseFloat(capacityRaw),
                status: parseInt(document.getElementById("status").value),
                chassisNumber: document.getElementById("chassisNumber").value || null,
                busTypeCode: document.getElementById("busTypeCode").value || null,
                hasAirConditioning: document.getElementById("hasAirConditioning").value === "true",
                maxKilometers: maxKmRaw === "" ? null : parseFloat(maxKmRaw),
                isInStorage: document.getElementById("isInStorage").value === "true",
                responsibilityCode: document.getElementById("responsibilityCode").value || null,
                responsibleEmployeeName: document.getElementById("responsibleEmployeeName").value || null
            };

            const method = id ? 'PUT' : 'POST';
            const url = id ? `/api/vehicles/${id}` : '/api/vehicles';

            try {
                const res = await fetch(url, {
                    method: method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(dto)
                });

                if (res.ok) {
                    const modalEl = document.getElementById('vehicleModal');
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    modal.hide();
                    loadVehicles();
                } else {
                    alert("Error saving vehicle data.");
                }
            } catch (err) {
                console.error(err);
            }
        }

        async function deleteVehicle(id) {
            const confirmMsg = currentLang === 'en' ? "Delete this vehicle?" : "هل أنت متأكد من حذف هذه المركبة؟";
            if (!confirm(confirmMsg)) return;

            try {
                const res = await fetch(`/api/vehicles/${id}`, { method: 'DELETE' });
                if (res.ok) {
                    loadVehicles();
                } else {
                    alert("Failed to delete vehicle.");
                }
            } catch (err) {
                console.error(err);
            }
        }

        async function handleBulkUpload(event, url) {
            const file = event.target.files[0];
            if (!file) return;

            const formData = new FormData();
            formData.append('file', file);

            try {
                const tbody = document.getElementById("vehiclesList");
                tbody.innerHTML = `<tr><td colspan="8" class="text-center text-muted"><i class="bi bi-arrow-repeat spin me-2"></i> Uploading...</td></tr>`;

                const res = await fetch(url, {
                    method: 'POST',
                    body: formData
                });

                if (res.ok) {
                    const result = await res.json();
                    let msg;
                    if (result.insertedRows !== undefined) {
                        msg = currentLang === 'en'
                            ? `Inserted ${result.insertedRows}, updated ${result.updatedRows}, skipped ${result.skippedRows}.`
                            : `تمت إضافة ${result.insertedRows}، وتحديث ${result.updatedRows}، وتخطي ${result.skippedRows}.`;
                    } else {
                        msg = currentLang === 'en' ? `Successfully imported ${result.successCount ?? 0} records.` : `تم استيراد ${result.successCount ?? 0} سجل بنجاح.`;
                    }
                    if (result.errors && result.errors.length > 0) {
                        const errText = result.errors.map(e => typeof e === 'string' ? e : `Row ${e.rowNumber}: ${e.message}`);
                        msg += "\nErrors:\n" + errText.slice(0, 5).join('\n');
                        if (errText.length > 5) msg += `\n...and ${errText.length - 5} more errors.`;
                    }
                    alert(msg);
                } else {
                    const text = await res.text();
                    alert("Bulk upload failed: " + text);
                }
            } catch (err) {
                console.error(err);
                alert("An error occurred during bulk upload.");
            } finally {
                event.target.value = "";
                currentPage = 1;
                loadVehicles();
            }
        }
    </script>
}
