@page
@model IndexModel
@{
    ViewData["Title"] = "Enterprise Dashboard";
}

<div class="py-4">
    <div class="text-center mb-5">
        <h1 data-i18n="dashboard-title" class="display-4 fw-extrabold mb-2" style="font-family: var(--font-outfit); background: linear-gradient(135deg, var(--brand-gold) 0%, var(--brand-gold-light) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
            RAWAHEL AL MASHAER CO
        </h1>
        <p data-i18n="dashboard-subtitle" class="text-muted fs-5">شركة رواحل المشاعر — Enterprise Portal</p>
        <hr class="border-glass w-25 mx-auto">
    </div>

    <div class="row g-4 justify-content-center mt-3">
        <!-- 1. Hajj & Umrah Sector -->
        <div class="col-md-6">
            <a href="/MohuStandards" class="text-decoration-none">
                <div class="glass-card h-100 d-flex flex-column justify-content-between p-5 text-center" style="transition: transform 0.3s, box-shadow 0.3s;">
                    <div>
                        <div class="mb-4" style="font-size: 4rem; color: var(--brand-gold);"><i class="bi bi-star"></i></div>
                        <h2 class="fw-bold mb-3">وزارة الحج والعمرة</h2>
                        <p class="text-muted fs-5">التطبيق الكلي لنظام المعايير الجديدة للحج والعمرة (MOHU Business)</p>
                    </div>
                    <div class="mt-4">
                        <span class="btn btn-neon btn-lg w-75">الدخول للقطاع →</span>
                    </div>
                </div>
            </a>
        </div>

        <!-- 2. Rawahel Internal Sector -->
        <div class="col-md-6">
            <a href="/RawahelDepartments" class="text-decoration-none">
                <div class="glass-card h-100 d-flex flex-column justify-content-between p-5 text-center" style="transition: transform 0.3s, box-shadow 0.3s;">
                    <div>
                        <div class="mb-4" style="font-size: 4rem; color: var(--brand-gold);"><i class="bi bi-building"></i></div>
                        <h2 class="fw-bold mb-3">رواحل للنقل المتخصص</h2>
                        <p class="text-muted fs-5">إدارات العمليات التشغيلية والمساندة لشركة رواحل المشاعر</p>
                    </div>
                    <div class="mt-4">
                        <span class="btn btn-neon btn-lg w-75">الدخول للقطاع →</span>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>
<style>
    .glass-card:hover { transform: translateY(-10px); box-shadow: 0 15px 30px rgba(212, 175, 55, 0.2) !important; }
</style>
